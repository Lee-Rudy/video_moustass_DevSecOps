# ==============================================================================
# .dockerignore - Fichiers à exclure lors du build Docker
# ==============================================================================

# Dossiers de build et target
target/
build/
dist/
out/

# Node modules et dépendances
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Fichiers de cache Maven
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# IDE et éditeurs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.iml
*.ipr
*.iws

# Git
.git/
.gitignore
.gitattributes
.github/

# Documentation et README
*.md
!README.md
LICENCE
LICENSE

# Fichiers de test et coverage
coverage/
*.log
test-results/
.jest/

# Fichiers de configuration locaux
.env
.env.local
.env.*.local
*.local

# Données et volumes locaux
data/
videos/
*.mp4
*.avi
*.mov

# Fichiers temporaires
tmp/
temp/
*.tmp

# Fichiers système
Thumbs.db
.DS_Store

# Fichiers Docker (évite la récursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# SonarCloud
.scannerwork/
sonar-project.properties

# Jacoco
*.exec

# Fichiers de backup
*.bak
*.backup
*~
