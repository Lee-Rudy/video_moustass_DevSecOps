# ============================================
# Configuration Moustass Video - OAuth2 + MFA
# ============================================
# 
# Instructions : 
# 1. Copiez ce fichier en .env
# 2. Remplissez les valeurs avec vos propres credentials
# 3. Ne commitez JAMAIS le fichier .env dans Git
#

# ============================================
# OAuth2 Google (OPTIONNEL)
# ============================================
# Pour activer OAuth2, décommentez les lignes dans application.properties
# et définissez ces variables d'environnement
# Obtenez ces valeurs depuis Google Cloud Console :
# https://console.cloud.google.com/apis/credentials

# GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=votre-client-secret

# Redirect URI (utilisé par Google OAuth2)
# Dev : http://localhost:8082/login/oauth2/code/google
# Prod : https://votre-domaine.com/login/oauth2/code/google
OAUTH2_REDIRECT_URI=http://localhost:8082/login/oauth2/code/google

# ============================================
# Email SMTP (pour l'envoi des codes MFA)
# ============================================
# Option 1 : Gmail
# Générez un mot de passe d'application : https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application

# Option 2 : SendGrid
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=votre-sendgrid-api-key

# Option 3 : Mailgun
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@votre-domaine.mailgun.org
# MAIL_PASSWORD=votre-mailgun-password

# ============================================
# Configuration MFA
# ============================================
# Durée de validité du code MFA (en minutes)
MFA_CODE_EXPIRATION=10

# Longueur du code MFA (6 recommandé)
MFA_CODE_LENGTH=6

# ============================================
# Base de données MySQL
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moustass_video
DB_USER=root
DB_PASSWORD=root

# ============================================
# JWT Configuration
# ============================================
# Secret JWT (minimum 32 caractères pour HS256)
# Générez un secret fort : https://www.grc.com/passwords.htm
JWT_SECRET=VotreSuperSecretJWTQuiFaitAuMoins32Caracteres!

# ============================================
# HashiCorp Vault
# ============================================
# Token d'accès Vault pour la gestion des clés de chiffrement
VAULT_TOKEN=votre-vault-token

# ============================================
# Frontend React
# ============================================
# URL du serveur backend
REACT_HOST=http://localhost
REACT_PORT=5173

# ============================================
# Stockage des vidéos
# ============================================
# Chemin de stockage des vidéos chiffrées
VIDEO_STORAGE_PATH=./data/videos

# ============================================
# Demo Login (Développement uniquement)
# ============================================
# Active/désactive le test de login au démarrage
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_MAIL=
DEMO_LOGIN_PASSWORD=
