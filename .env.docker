# ==============================================================================
# Fichier d'environnement pour Docker Compose
# ==============================================================================
# ⚠️  IMPORTANT: NE JAMAIS COMMITTER CE FICHIER AVEC DES VRAIES VALEURS !
# ⚠️  Copier ce fichier en .env et remplacer les valeurs par vos secrets
# ==============================================================================

# =============================================================================
# Configuration MySQL
# =============================================================================
MYSQL_ROOT_PASSWORD=root_secure_password_2026
MYSQL_DATABASE=moustass_video
MYSQL_USER=moustass_user
MYSQL_PASSWORD=moustass_password_2026

# =============================================================================
# Configuration Vault
# =============================================================================
# Token pour accéder à Vault (en DEV uniquement, utiliser un vrai système en PROD)
VAULT_TOKEN=dev-only-token-change-in-prod

# =============================================================================
# Configuration JWT
# =============================================================================
# Secret JWT (minimum 32 caractères pour HS256)
JWT_SECRET=PleaseChangeMeInProdUseAtLeast32CharactersForSecurity2026!

# =============================================================================
# Configuration Email SMTP (pour MFA)
# =============================================================================
# Compte Gmail qui ENVOIE les codes MFA
SMTP_USERNAME=brunerleerudy@gmail.com
# Mot de passe d'application Gmail (16 caractères)
SMTP_PASSWORD=jmlm zwbc hwej wilb

# =============================================================================
# Configuration OAuth2 Google
# =============================================================================
# Obtenir ces valeurs depuis Google Cloud Console
GOOGLE_CLIENT_ID=485222580684-rs5akaebqn716sfiu00sp9levf1r3dhg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
# Redirect URI pour OAuth2 (doit correspondre à la configuration Google Cloud)
OAUTH2_REDIRECT_URI=http://localhost:8082/login/oauth2/code/google

# =============================================================================
# Configuration Docker Hub
# =============================================================================
# Votre nom d'utilisateur Docker Hub
DOCKER_USERNAME=moustass
# Version de l'image (par défaut: latest)
VERSION=latest

# =============================================================================
# Configuration Avancée (optionnel)
# =============================================================================
# Configuration MFA
MFA_CODE_EXPIRATION=10
MFA_CODE_LENGTH=6

# Demo Login (désactivé par défaut)
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_MAIL=
DEMO_LOGIN_PASSWORD=
